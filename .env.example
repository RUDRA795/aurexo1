# ==============================================================================
# AUREXO // Marine Intelligence Platform - Environment Variables Template
# Copy this file to .env.local for local overrides, or copy into Vercel Dashboard.
# ==============================================================================

# Primary Cloud LLM (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ESCALATION_MODEL=gemini-1.5-pro
GEMINI_TIMEOUT_MS=12000

# High-Speed Cloud LLM Gateway (OmniRoute / OpenRouter)
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_BASE_URL=https://specs-prime-excess-accidents.trycloudflare.com/v1
OMNIROUTE_LOCAL_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=default
OMNIROUTE_TIMEOUT_MS=12000

# Real-Time Google Web Search API (SerpApi)
SERPAPI_API_KEY=your_serpapi_key_here

# Real-Time Indian EEZ Shipborne AIS Transponder Stream
AISSTREAM_API_KEY=your_aisstream_api_key_here
AIS_API_KEY=your_aisstream_api_key_here

# Shipboard / Local Edge Offline LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_PRIMARY_MODEL=llama3.2:3b
OLLAMA_FALLBACK_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=90000
OLLAMA_CONTEXT_WINDOW=2048
OLLAMA_NUM_PREDICT=384
OLLAMA_KEEP_ALIVE=10m
